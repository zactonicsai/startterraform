# =============================================================
#  Keycloak on AWS - configuration
#  Copy to config.env and fill in YOUR values.
#  config.env is git-ignored. Never commit it.
# =============================================================

# ---- AWS ----
AWS_REGION=us-east-1
PROJECT=keycloak-demo

# ---- DNS / TLS ----
# Public hostname your users will visit.
DOMAIN_NAME=auth.example.com
# Route 53 hosted zone that contains DOMAIN_NAME. Leave blank to skip DNS.
ROUTE53_ZONE_NAME=example.com
# ACM certificate ARN. MUST be in the same region as the ALB.
ACM_CERT_ARN=arn:aws:acm:us-east-1:111122223333:certificate/REPLACE-ME

# ---- Artifactory ----
ARTIFACTORY_HOST=mycompany.jfrog.io
ARTIFACTORY_USER=svc-keycloak-deploy
ARTIFACTORY_TOKEN=REPLACE-ME
# Full image path INCLUDING an explicit tag. Never use :latest.
KC_IMAGE=mycompany.jfrog.io/docker-local/keycloak:26.4.0

# ---- Sizing ----
INSTANCE_TYPE=t3.medium
ASG_MIN=2
ASG_MAX=6
DB_INSTANCE_CLASS=db.t3.medium
DB_ALLOCATED_STORAGE=20

# ---- Cost / resilience switches ----
# true  = one shared NAT Gateway  (~$35/mo, cheaper, less resilient)
# false = one NAT Gateway per AZ  (~$70/mo, recommended for prod)
SINGLE_NAT=false

# true  = synchronous standby in a 2nd AZ (roughly doubles DB cost)
DB_MULTI_AZ=true

# Days of automated backups. Never 0.
DB_BACKUP_RETENTION=7
