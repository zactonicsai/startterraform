###############################################################################
# 03-keycloak.tf
# The Keycloak application server, running as a Docker container on one EC2
# instance.
#
# Boot sequence handled by user_data below:
#   1. Update Amazon Linux and install Docker, AWS CLI, jq, and OpenSSL
#   2. Start Docker and pull quay.io/keycloak/keycloak:26.7.0
#   3. Fetch the database and Keycloak admin passwords from Secrets Manager
#   4. Download the RDS certificate bundle so database TLS can be verified
#   5. Generate a self-signed HTTPS certificate for the Keycloak console
#   6. Create a protected Docker environment file
#   7. Create a systemd service that runs and restarts the Keycloak container
###############################################################################

variable "keycloak_container_image" {
  description = "Docker image used to run Keycloak. Pinning the version avoids unexpected upgrades."
  type        = string
  default     = "quay.io/keycloak/keycloak:26.7.0"
}

variable "instance_type" {
  description = <<-EOT
    EC2 size. Keycloak is a Java app and wants RAM more than CPU.
    t4g.small  - 2 GB RAM, ARM Graviton. Small lab or test system.
    t4g.medium - 4 GB RAM. Recommended for a larger lab.
    t4g.large  - 8 GB RAM. Better for a production-like single node.
  EOT
  type        = string
  default     = "t4g.small"
}

variable "keycloak_admin_user" {
  description = "Bootstrap admin username for the Keycloak console."
  type        = string
  default     = "kcadmin"
}

variable "ssh_key_name" {
  description = "Existing EC2 key pair name for SSH. Leave empty to use SSM Session Manager only (recommended)."
  type        = string
  default     = ""
}

variable "root_volume_size" {
  description = "Root disk size in GB. Docker images and container logs use this disk."
  type        = number
  default     = 20
}

###############################################################################
# AMI LOOKUP
# Amazon Linux 2023, ARM64 (Graviton). Looked up dynamically so you always
# get the latest patched image instead of a stale hard-coded AMI ID.
###############################################################################

data "aws_ssm_parameter" "al2023_arm64" {
  name = "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-arm64"
}

###############################################################################
# KEYCLOAK ADMIN PASSWORD
# Generated and stored in Secrets Manager. The EC2 instance reads it through
# its IAM role during the first boot.
###############################################################################

resource "random_password" "keycloak_admin" {
  length           = 24
  special          = true
  override_special = "!#$%&*-_=+"
  min_upper        = 2
  min_lower        = 2
  min_numeric      = 2
  min_special      = 2
}

resource "aws_secretsmanager_secret" "keycloak_admin" {
  name                    = "${var.project_name}/db-keycloak-admin-${random_id.suffix.hex}"
  description             = "Keycloak bootstrap admin credentials"
  recovery_window_in_days = 0

  tags = {
    Name = "${var.project_name}-keycloak-admin"
  }
}

resource "aws_secretsmanager_secret_version" "keycloak_admin" {
  secret_id = aws_secretsmanager_secret.keycloak_admin.id

  secret_string = jsonencode({
    username = var.keycloak_admin_user
    password = random_password.keycloak_admin.result
  })
}

###############################################################################
# ELASTIC IP
# A permanent public IP. Without it, stopping and starting the instance can
# give the server a different public address.
###############################################################################

resource "aws_eip" "keycloak" {
  domain = "vpc"

  tags = {
    Name = "${var.project_name}-keycloak-eip"
  }

  depends_on = [aws_internet_gateway.main]
}

resource "aws_eip_association" "keycloak" {
  instance_id   = aws_instance.keycloak.id
  allocation_id = aws_eip.keycloak.id
}

###############################################################################
# BOOTSTRAP SCRIPT
# Runs once, as root, the first time the instance boots.
#
# Main logs:
#   /var/log/cloud-init-output.log
#   /var/log/keycloak-bootstrap.log
#   journalctl -u keycloak-container
#   docker logs keycloak
###############################################################################

locals {
  user_data = <<-BOOTSTRAP
#!/bin/bash
set -euxo pipefail
exec > >(tee /var/log/keycloak-bootstrap.log | logger -t keycloak-bootstrap) 2>&1

KEYCLOAK_IMAGE="${var.keycloak_container_image}"
CONTAINER_NAME="keycloak"
KEYCLOAK_CONFIG_DIR="/etc/keycloak"

echo "=== [1/8] Updating the operating system and installing Docker ==="
dnf update -y
dnf install -y docker jq awscli openssl ca-certificates
systemctl enable --now docker

# Wait briefly for the Docker daemon to become ready.
for attempt in $(seq 1 30); do
  if docker info >/dev/null 2>&1; then
    break
  fi
  sleep 2
done

docker info >/dev/null

echo "=== [2/8] Pulling Keycloak image: $KEYCLOAK_IMAGE ==="
docker pull "$KEYCLOAK_IMAGE"

echo "=== [3/8] Reading secrets through the EC2 IAM role ==="
export AWS_DEFAULT_REGION="${data.aws_region.current.name}"

DB_SECRET=$(aws secretsmanager get-secret-value \
  --secret-id "${aws_secretsmanager_secret.db.name}" \
  --query SecretString \
  --output text)
DB_USER=$(echo "$DB_SECRET" | jq -r .username)
DB_PASS=$(echo "$DB_SECRET" | jq -r .password)

KC_SECRET=$(aws secretsmanager get-secret-value \
  --secret-id "${aws_secretsmanager_secret.keycloak_admin.name}" \
  --query SecretString \
  --output text)
KC_ADMIN_USER=$(echo "$KC_SECRET" | jq -r .username)
KC_ADMIN_PASS=$(echo "$KC_SECRET" | jq -r .password)

install -d -m 0755 "$KEYCLOAK_CONFIG_DIR"

echo "=== [4/8] Downloading the AWS RDS certificate bundle ==="
curl -fsSL \
  -o "$KEYCLOAK_CONFIG_DIR/rds-ca.pem" \
  "https://truststore.pki.rds.amazonaws.com/${data.aws_region.current.name}/${data.aws_region.current.name}-bundle.pem"
chmod 0644 "$KEYCLOAK_CONFIG_DIR/rds-ca.pem"

echo "=== [5/8] Generating a self-signed HTTPS certificate ==="
PUBLIC_IP="${aws_eip.keycloak.public_ip}"

openssl req \
  -x509 \
  -nodes \
  -newkey rsa:2048 \
  -sha256 \
  -days 3650 \
  -keyout "$KEYCLOAK_CONFIG_DIR/tls.key" \
  -out "$KEYCLOAK_CONFIG_DIR/tls.crt" \
  -subj "/CN=$PUBLIC_IP" \
  -addext "subjectAltName=IP:$PUBLIC_IP"

# The official Keycloak image runs as a non-root user. Numeric ownership lets
# that container user read the private key without making it public to all
# users on the EC2 host.
chown 1000:0 "$KEYCLOAK_CONFIG_DIR/tls.key"
chmod 0640 "$KEYCLOAK_CONFIG_DIR/tls.key"
chmod 0644 "$KEYCLOAK_CONFIG_DIR/tls.crt"

echo "=== [6/8] Writing the protected Docker environment file ==="
cat > "$KEYCLOAK_CONFIG_DIR/keycloak.env" <<ENVFILE
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://${aws_db_instance.keycloak.address}:5432/${var.db_name}?sslmode=verify-full&sslrootcert=/opt/keycloak/conf/rds-ca.pem
KC_DB_USERNAME=$DB_USER
KC_DB_PASSWORD=$DB_PASS
KC_DB_POOL_INITIAL_SIZE=5
KC_DB_POOL_MIN_SIZE=5
KC_DB_POOL_MAX_SIZE=20
KC_BOOTSTRAP_ADMIN_USERNAME=$KC_ADMIN_USER
KC_BOOTSTRAP_ADMIN_PASSWORD=$KC_ADMIN_PASS
KC_HTTP_ENABLED=true
KC_HTTP_PORT=8080
KC_HTTPS_PORT=8443
KC_HTTPS_CERTIFICATE_FILE=/opt/keycloak/conf/tls.crt
KC_HTTPS_CERTIFICATE_KEY_FILE=/opt/keycloak/conf/tls.key
KC_HOSTNAME=https://$PUBLIC_IP:8443
KC_HOSTNAME_STRICT=false
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true
KC_LOG=console
KC_LOG_LEVEL=INFO
JAVA_OPTS_APPEND=-Xms512m -Xmx1024m
ENVFILE

chmod 0600 "$KEYCLOAK_CONFIG_DIR/keycloak.env"

echo "=== [7/8] Creating the Keycloak container systemd service ==="
cat > /etc/systemd/system/keycloak-container.service <<UNIT
[Unit]
Description=Keycloak Docker Container
Documentation=https://www.keycloak.org/server/containers
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=15
TimeoutStartSec=0
TimeoutStopSec=45

# Remove an old stopped container before starting a fresh one.
ExecStartPre=-/usr/bin/docker rm -f $CONTAINER_NAME

# Host networking lets Keycloak listen directly on EC2 ports 8080 and 8443.
# The EC2 security group remains the outer firewall.
ExecStart=/usr/bin/docker run \
  --name $CONTAINER_NAME \
  --network host \
  --env-file $KEYCLOAK_CONFIG_DIR/keycloak.env \
  --mount type=bind,source=$KEYCLOAK_CONFIG_DIR/rds-ca.pem,target=/opt/keycloak/conf/rds-ca.pem,readonly \
  --mount type=bind,source=$KEYCLOAK_CONFIG_DIR/tls.crt,target=/opt/keycloak/conf/tls.crt,readonly \
  --mount type=bind,source=$KEYCLOAK_CONFIG_DIR/tls.key,target=/opt/keycloak/conf/tls.key,readonly \
  --security-opt no-new-privileges:true \
  --stop-timeout 30 \
  $KEYCLOAK_IMAGE \
  start

ExecStop=/usr/bin/docker stop -t 30 $CONTAINER_NAME
ExecStopPost=-/usr/bin/docker rm -f $CONTAINER_NAME

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now keycloak-container

echo "=== [8/8] Verifying that the Keycloak container started ==="
for attempt in $(seq 1 60); do
  if docker inspect -f '{{.State.Running}}' "$CONTAINER_NAME" 2>/dev/null | grep -q true; then
    echo "Keycloak container is running."
    break
  fi
  sleep 2
done

docker ps --filter "name=$CONTAINER_NAME"

echo "=== Bootstrap complete. Keycloak is starting on https://$PUBLIC_IP:8443 ==="
  BOOTSTRAP
}

###############################################################################
# THE EC2 INSTANCE
###############################################################################

resource "aws_instance" "keycloak" {
  ami           = data.aws_ssm_parameter.al2023_arm64.value
  instance_type = var.instance_type

  subnet_id              = aws_subnet.public.id
  vpc_security_group_ids = [aws_security_group.keycloak.id]
  iam_instance_profile   = aws_iam_instance_profile.keycloak.name

  # Empty string means "no key pair", which is fine because SSM Session
  # Manager gives you a shell without an SSH key.
  key_name = var.ssh_key_name != "" ? var.ssh_key_name : null

  user_data                   = local.user_data
  user_data_replace_on_change = true

  root_block_device {
    volume_type           = "gp3"
    volume_size           = var.root_volume_size
    encrypted             = true
    delete_on_termination = true
  }

  # Require IMDSv2 to reduce the risk of applications stealing the EC2 IAM
  # role credentials through a server-side request forgery attack.
  metadata_options {
    http_endpoint               = "enabled"
    http_tokens                 = "required"
    http_put_response_hop_limit = 1
    instance_metadata_tags      = "enabled"
  }

  monitoring = false

  tags = {
    Name = "${var.project_name}-keycloak"
  }

  depends_on = [
    aws_db_instance.keycloak,
    aws_secretsmanager_secret_version.db,
    aws_secretsmanager_secret_version.keycloak_admin,
  ]
}

###############################################################################
# OUTPUTS
###############################################################################

output "keycloak_url" {
  description = "Open this in your browser and accept the self-signed certificate warning."
  value       = "https://${aws_eip.keycloak.public_ip}:8443"
}

output "keycloak_admin_console" {
  description = "Direct link to the Keycloak admin console."
  value       = "https://${aws_eip.keycloak.public_ip}:8443/admin"
}

output "keycloak_container_image" {
  description = "Pinned Docker image used by the EC2 instance."
  value       = var.keycloak_container_image
}

output "keycloak_public_ip" {
  description = "Elastic IP of the Keycloak server."
  value       = aws_eip.keycloak.public_ip
}

output "keycloak_instance_id" {
  description = "EC2 instance ID."
  value       = aws_instance.keycloak.id
}

output "keycloak_admin_secret_name" {
  description = "Secrets Manager secret holding the Keycloak admin credentials."
  value       = aws_secretsmanager_secret.keycloak_admin.name
}

output "get_admin_password_command" {
  description = "Run this to retrieve the Keycloak admin password."
  value       = "aws secretsmanager get-secret-value --secret-id ${aws_secretsmanager_secret.keycloak_admin.name} --query SecretString --output text | jq ."
}

output "ssm_shell_command" {
  description = "Get a shell on the server without SSH."
  value       = "aws ssm start-session --target ${aws_instance.keycloak.id}"
}

output "keycloak_container_status_command" {
  description = "Run after connecting with SSM to check the Keycloak container."
  value       = "sudo systemctl status keycloak-container --no-pager && sudo docker ps --filter name=keycloak"
}

output "keycloak_container_logs_command" {
  description = "Run after connecting with SSM to follow Keycloak logs."
  value       = "sudo docker logs --tail 200 --follow keycloak"
}

output "allowed_source_ip" {
  description = "The only IP address permitted to reach Keycloak."
  value       = var.my_ip_cidr
}
