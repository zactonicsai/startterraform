# ---- Secrets and local config: NEVER commit these ----
config.env
terraform.tfvars
*.auto.tfvars
!terraform.tfvars.example
!example-*.tfvars

# ---- CLI script state (contains AWS resource ids) ----
cli/state/
state/

# ---- Terraform ----
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
tf.plan
crash.log

# ---- Exports: these contain ENCRYPTED CREDENTIALS from your flows ----
migration/exports/
exports/

# ---- Local NiFi data: flows, in-flight data, provenance, logs ----
local-mac/data/
local-mac/sandbox/

# ---- Kubernetes secrets rendered from templates ----
eks/manifests/01-secrets-pull.yaml
eks/manifests/*-rendered.yaml

# ---- OS / editor noise ----
.DS_Store
*.swp
*~
.idea/
.vscode/
