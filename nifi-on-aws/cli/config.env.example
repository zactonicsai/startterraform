# ===========================================================================
#  Copy to config.env and edit. config.env is gitignored.
# ===========================================================================

# ---- Naming and region ----
export PROJECT="nifi-demo"          # prefix for every resource name
export AWS_REGION="eu-west-1"

# ---- HOW BIG ----
# 1  = the simple single-node example. No ALB, no ZooKeeper. Start here.
# 3  = a real cluster across Availability Zones, with ALB and ZooKeeper.
#      Use an ODD number. See guide Chapter 7 for why.
export NODE_COUNT=1

# ---- Instance sizing ----
# NiFi is memory- and disk-IO-hungry. t3.medium is the floor for a demo and
# will feel slow. m6i.large is a sensible small production node.
export NIFI_INSTANCE_TYPE="t3.large"
export ZK_INSTANCE_TYPE="t3.small"

# ---- Storage ----
# A SEPARATE EBS volume holds every NiFi repository, so an instance can be
# replaced without losing in-flight data. This is the single most important
# choice in the whole deployment - see guide Chapter 7.
export DATA_VOLUME_GB=100
export DATA_VOLUME_TYPE="gp3"
export ROOT_VOLUME_GB=30

# ---- The NiFi image, from Artifactory ----
# Your Artifactory Docker registry host, and the repository path within it.
export ARTIFACTORY_REGISTRY="mycompany.jfrog.io"
export ARTIFACTORY_REPO="docker-remote"
export NIFI_IMAGE_NAME="apache/nifi"
# 2.10.0 is current (June 2026). DO NOT go at or below 2.7.2:
# CVE-2026-25903 is a high-severity authorisation bypass fixed in 2.8.0.
export NIFI_VERSION="2.10.0"
export ZK_IMAGE="zookeeper:3.9"

# Full image reference used by docker pull:
export NIFI_IMAGE="${ARTIFACTORY_REGISTRY}/${ARTIFACTORY_REPO}/${NIFI_IMAGE_NAME}:${NIFI_VERSION}"

# ---- Artifactory credentials ----
# Do NOT put the password here. Put it in Secrets Manager - 04-secrets.sh
# prompts for it once and stores it. This is only the username.
export ARTIFACTORY_USER="svc-nifi-puller"

# ---- Access ----
# Your public IP, so only you can reach the load balancer while testing.
# Find it with: curl -s https://checkip.amazonaws.com
export MY_IP_CIDR="203.0.113.10/32"

# ---- TLS (needed only when NODE_COUNT > 1, i.e. when there is an ALB) ----
# The certificate MUST be in the SAME REGION as the load balancer.
export ACM_CERT_ARN=""
# Optional: a Route 53 hosted zone and hostname for a friendly URL.
export HOSTED_ZONE_ID=""
export NIFI_HOSTNAME=""             # e.g. nifi.example.com

# ---- Networking ----
export VPC_CIDR="10.20.0.0/16"

# ---- Where the scripts remember what they created ----
export STATE_DIR="${STATE_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/state}"
